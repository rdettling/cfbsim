{
  "name": "cfbsim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "start": "sirv dist --single --host 0.0.0.0",
    "preview": "vite preview",
    "data:build": "tsx scripts/data_build.ts",
    "data:check": "tsx scripts/data_check.ts",
    "fetch:season-results": "node --env-file-if-exists=.env --import tsx scripts/fetch_season_results.ts",
    "fetch:game-history": "node --env-file-if-exists=.env --import tsx scripts/fetch_game_history.ts",
    "transform:game-history": "node --import tsx scripts/transform_game_history.ts",
    "generate:sim-benchmark": "tsx scripts/generate_sim_benchmark.ts",
    "eval:sim": "tsx scripts/eval_sim.ts",
    "eval:sim-stability": "tsx scripts/eval_sim_stability.ts",
    "tune:sim": "tsx scripts/tune_sim.ts",
    "eval:recruiting-balance": "tsx scripts/eval_recruiting_balance.ts",
    "eval:news": "tsx scripts/eval_news.ts",
    "eval:awards": "tsx scripts/eval_awards.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.scripts.json"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "sirv-cli": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
